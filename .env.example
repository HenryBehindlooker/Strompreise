# Vorlage für die lokale Konfiguration.
# Kopieren nach `.env` (wird nicht committet): cp .env.example .env
# Keine echten Secrets in diese Datei schreiben – Werte hier bleiben leer
# oder enthalten nur harmlose Standardwerte.

# SQLite-Datenbankdatei (im Docker-Setup auf einem Volume)
DATABASE_PATH=./data/strompreise.db

# Hintergrund-Jobs (Strommix, Preise, EE-Prognose) im Server-Prozess starten
JOBS_ENABLED=true

# Kontakt im User-Agent für Upstream-APIs (Repo-URL, kein Mail-Empfänger nötig)
USER_AGENT_CONTACT=https://github.com/HenryBehindlooker/Strompreise

# Ampel: Gewichte und Schwellen (Standardwerte stehen hier)
AMPEL_WEIGHT_PRICE=0.5
AMPEL_WEIGHT_RENEWABLE=0.5
AMPEL_GREEN_MIN=0.66
AMPEL_YELLOW_MIN=0.33

# Web-Push für den Morgen-Hinweis (optional). Beide Schlüssel setzen, sonst bleibt Push aus.
# Erzeugen mit: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=https://github.com/HenryBehindlooker/Strompreise
